NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
SESSION_SECRET=replace-with-at-least-32-random-bytes
ACCESS_TOKEN_SECRET=replace-with-a-different-32-character-minimum-secret
DATA_ENCRYPTION_KEY=base64-encoded-32-byte-key
APP_ORIGIN=http://localhost:3000
DISPLAY_TIME_ZONE=America/Costa_Rica
# In production set DATABASE_SSL=true and use platform-managed secrets.
