<%- include('partials/header') %>

<section class="card narrow">
  <div class="security-pill">
    <svg width="14" height="14" style="width:14px;height:14px;max-width:14px;max-height:14px;display:inline-block;" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 1.944A11.954 11.954 0 012.166 5C2.056 5.649 2 6.319 2 7c0 5.225 3.34 9.67 8 11.317C14.66 16.67 18 12.225 18 7c0-.682-.057-1.35-.166-2.001A11.954 11.954 0 0110 1.944zM11 14a1 1 0 11-2 0 1 1 0 012 0zm0-7a1 1 0 10-2 0v3a1 1 0 102 0V7z" clip-rule="evenodd"></path></svg>
    Registro con Controles Criptográficos
  </div>

  <h1>Crear Cuenta</h1>
  <p class="lead">Registra una cuenta para guardar notas y datos protegidos.</p>

  <form action="/register" method="post">
    <input type="hidden" name="csrfToken" value="<%= csrfToken %>">

    <label for="name">Nombre Completo</label>
    <input id="name" name="name" maxlength="80" placeholder="Ej. Luna Mena" autocomplete="name" required>

    <label for="email">Correo Electrónico</label>
    <input type="email" id="email" name="email" placeholder="luna@umbrafiction.example" autocomplete="email" required>

    <label for="phone">Teléfono (Dato Sensible - Opcional)</label>
    <input id="phone" name="phone" maxlength="32" placeholder="Ej. 8888-1234" autocomplete="tel">
    <span class="hint" style="display:block;margin-top:0.25rem;">Se guardará cifrado con AES-256-GCM y se mostrará enmascarado.</span>

    <label for="password">Contraseña Maestra</label>
    <input type="password" id="password" name="password" placeholder="Mínimo 12 caracteres (Aa1!)" autocomplete="new-password" required>
    <span class="hint" style="display:block;margin-top:0.25rem;">Requiere 12+ caracteres, con mayúscula, minúscula, número y símbolo.</span>

    <button class="full-width" type="submit">
      Crear Cuenta Segura
    </button>
  </form>

  <div style="margin-top: 1.75rem; padding-top: 1.25rem; border-top: 1px solid var(--border-subtle); text-align: center; font-size: 0.9rem;">
    <p>¿Ya tienes una cuenta registrada? <a href="/login">Inicia sesión</a></p>
  </div>
</section>

<%- include('partials/footer') %>
