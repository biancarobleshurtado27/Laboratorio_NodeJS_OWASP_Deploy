<%- include('partials/header') %>

<div class="flex flex-col w-full items-center justify-center relative overflow-hidden py-8 px-4">
  <!-- Glow Background -->
  <div class="absolute inset-0 pointer-events-none flex items-center justify-center opacity-30">
    <div class="w-[500px] h-[500px] rounded-full bg-gradient-to-tr from-secondary/20 to-primary-container/10 blur-3xl transform scale-110"></div>
  </div>

  <!-- Primary Registration Card -->
  <div class="relative w-full max-w-[480px] bg-surface-container-low border border-outline-variant/40 rounded-xl shadow-2xl p-6 sm:p-8 z-10 flex flex-col gap-6 backdrop-blur-md">
    <!-- Header -->
    <div class="flex flex-col items-center text-center gap-2">
      <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-surface-container-highest text-secondary font-mono text-xs tracking-wide border border-outline-variant/30">
        <span class="material-symbols-outlined text-secondary text-[14px]">shield</span>
        <span>Aislamiento de Identidad (OWASP A04)</span>
      </div>

      <div class="mt-2 w-12 h-12 rounded-lg bg-surface-container flex items-center justify-center border border-secondary/20 shadow-inner">
        <span class="material-symbols-outlined text-secondary text-2xl">person_add</span>
      </div>

      <div class="flex flex-col gap-1 mt-1">
        <h1 class="font-headline text-2xl text-on-surface font-bold tracking-tight">Crear Cuenta Segura</h1>
        <p class="text-sm text-on-surface-variant max-w-[360px] leading-relaxed">
          Registra tus credenciales en la bóveda con cifrado en reposo y hash irreversible.
        </p>
      </div>
    </div>

    <!-- Form -->
    <form action="/register" method="post" class="flex flex-col gap-4">
      <input type="hidden" name="csrfToken" value="<%= csrfToken %>">

      <!-- Field: Nombre -->
      <div class="flex flex-col gap-1.5">
        <label class="text-xs font-medium text-on-surface-variant flex items-center justify-between" for="name">
          <span>Nombre Completo</span>
          <span class="font-mono text-[11px] text-outline">2 - 80 car.</span>
        </label>
        <div class="relative flex items-center">
          <span class="material-symbols-outlined absolute left-3 text-outline text-lg pointer-events-none">badge</span>
          <input class="w-full h-10 pl-10 pr-3 bg-surface-container-lowest text-on-surface text-sm rounded-lg border border-outline-variant/40 placeholder:text-outline focus:outline-none focus:border-secondary focus:ring-1 focus:ring-secondary/40 transition-all shadow-inner" id="name" name="name" maxlength="80" placeholder="Luna Mena" required autocomplete="name"/>
        </div>
      </div>

      <!-- Field: Correo -->
      <div class="flex flex-col gap-1.5">
        <label class="text-xs font-medium text-on-surface-variant flex items-center justify-between" for="email">
          <span>Correo Electrónico</span>
          <span class="font-mono text-[11px] text-outline">RFC 5322</span>
        </label>
        <div class="relative flex items-center">
          <span class="material-symbols-outlined absolute left-3 text-outline text-lg pointer-events-none">mail</span>
          <input class="w-full h-10 pl-10 pr-3 bg-surface-container-lowest text-on-surface text-sm rounded-lg border border-outline-variant/40 placeholder:text-outline focus:outline-none focus:border-secondary focus:ring-1 focus:ring-secondary/40 transition-all shadow-inner" id="email" name="email" placeholder="luna@umbrafiction.example" required type="email" autocomplete="email"/>
        </div>
      </div>

      <!-- Field: Teléfono Sensible -->
      <div class="flex flex-col gap-1.5">
        <label class="text-xs font-medium text-on-surface-variant flex items-center justify-between" for="phone">
          <span>Teléfono (Dato Sensible Opcional)</span>
          <span class="font-mono text-[11px] text-tertiary">AES-256-GCM</span>
        </label>
        <div class="relative flex items-center">
          <span class="material-symbols-outlined absolute left-3 text-outline text-lg pointer-events-none">call</span>
          <input class="w-full h-10 pl-10 pr-3 bg-surface-container-lowest text-on-surface text-sm rounded-lg border border-outline-variant/40 placeholder:text-outline focus:outline-none focus:border-secondary focus:ring-1 focus:ring-secondary/40 transition-all shadow-inner" id="phone" name="phone" maxlength="32" placeholder="8888-1234" autocomplete="tel"/>
        </div>
        <span class="font-mono text-[11px] text-outline">Se guardará cifrado y se mostrará enmascarado (***-***-1234).</span>
      </div>

      <!-- Field: Contraseña -->
      <div class="flex flex-col gap-1.5">
        <label class="text-xs font-medium text-on-surface-variant flex items-center justify-between" for="password">
          <span>Contraseña Maestra</span>
          <span class="font-mono text-[11px] text-outline">Bcrypt (Cost 12)</span>
        </label>
        <div class="relative flex items-center">
          <span class="material-symbols-outlined absolute left-3 text-outline text-lg pointer-events-none">lock</span>
          <input class="w-full h-10 pl-10 pr-3 bg-surface-container-lowest text-on-surface font-mono text-sm rounded-lg border border-outline-variant/40 placeholder:text-outline focus:outline-none focus:border-secondary focus:ring-1 focus:ring-secondary/40 transition-all shadow-inner" id="password" name="password" placeholder="ClaveSegura2026!" required type="password" autocomplete="new-password"/>
        </div>
        <div class="p-2.5 rounded bg-surface-container border border-outline-variant/30 text-[11px] font-mono text-on-surface-variant space-y-0.5">
          <div class="text-secondary font-semibold">Política de contraseñas:</div>
          <div>• Mínimo 12 caracteres</div>
          <div>• Requiere mayúscula, minúscula, número y símbolo</div>
        </div>
      </div>

      <!-- Submit Action -->
      <button class="w-full h-11 bg-primary text-on-primary font-semibold text-sm rounded-lg flex items-center justify-center gap-2 hover:bg-primary-container transition-all shadow-md mt-2 group" type="submit">
        <span>Crear Cuenta Segura</span>
        <span class="material-symbols-outlined text-lg group-hover:translate-x-0.5 transition-transform">arrow_forward</span>
      </button>
    </form>

    <div class="pt-4 border-t border-outline-variant/30 text-center text-xs text-on-surface-variant">
      <span>¿Ya posees una cuenta registrada?</span>
      <a href="/login" class="text-secondary font-semibold hover:underline ml-1">Inicia sesión</a>
    </div>
  </div>
</div>

<%- include('partials/footer') %>
