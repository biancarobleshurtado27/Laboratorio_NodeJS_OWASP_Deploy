<%- include('partials/header') %>

<section class="card narrow">
  <div class="security-pill">
    <svg fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 9a3 3 0 100-6 3 3 0 000 6zm-7 9a7 7 0 1114 0H3z" clip-rule="evenodd"></path></svg>
    Datos de Usuario y Enmascaramiento
  </div>

  <h1>Mi Perfil Corporativo</h1>
  <p class="lead">Información de tu identidad y datos protegidos en la base de datos.</p>

  <dl>
    <dt>Nombre</dt>
    <dd><%= profile.name %></dd>

    <dt>Correo</dt>
    <dd><%= profile.email %></dd>

    <dt>Teléfono</dt>
    <dd>
      <span style="font-family: var(--font-mono); color: #38bdf8; font-weight: 600;"><%= profile.phone %></span>
    </dd>

    <dt>Rol Actual</dt>
    <dd>
      <span class="brand-badge" style="background: <%= user.role === 'admin' ? 'rgba(245, 158, 11, 0.2)' : 'rgba(59, 130, 246, 0.2)' %>; color: <%= user.role === 'admin' ? '#fbbf24' : '#60a5fa' %>;">
        <%= user.role === 'admin' ? '🛡️ Administrador' : '👤 Usuario Bóveda' %>
      </span>
    </dd>
  </dl>

  <p class="hint">
    🛡️ <strong>Control OWASP RF-05:</strong> El teléfono se almacena cifrado en reposo con AES-256-GCM y en la interfaz se presenta enmascarado para evitar fuga de información sensible.
  </p>

  <div style="margin-top: 2rem; display: flex; gap: 1rem;">
    <a href="/notes" class="button secondary full-width">Volver a mis notas</a>
  </div>
</section>

<%- include('partials/footer') %>
