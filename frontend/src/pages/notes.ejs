<%- include('partials/header') %>

<div class="page-header animate-fade-in">
  <div>
    <div class="security-pill">
      <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg>
      Cifrado en Reposo Activo (AES-256-GCM)
    </div>
    <h1>Bóveda de Notas Privadas</h1>
    <p style="margin: 0;">Cada registro se almacena con un vector de inicialización único y autenticación criptográfica.</p>
  </div>
</div>

<section class="split">
  <div class="notes-feed">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.25rem;">
      <h2>Tus Notas Confidenciales</h2>
      <span class="brand-badge" style="background: rgba(59, 130, 246, 0.15); color: #93c5fd;"><%= notes.length %> registros</span>
    </div>

    <% if (!notes.length) { %>
      <div class="empty animate-scale-in">
        <svg width="36" height="36" style="width:36px;height:36px;margin:0 auto 0.75rem auto;display:block;opacity:0.6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"/>
        </svg>
        <p>No tienes notas registradas en esta bóveda todavía.</p>
        <small>Utiliza el formulario contiguo para crear tu primer secreto protegido.</small>
      </div>
    <% } %>

    <% notes.forEach((note, index) => { %>
      <article class="note animate-slide-up" style="animation-delay: <%= index * 0.05 %>s;">
        <div class="note-header">
          <h2><%= note.title %></h2>
          <span class="note-badge">
            <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
            GCM Verified
          </span>
        </div>
        <p><%= note.content %></p>
        <small>Última actualización: <%= formatDateTime(note.updated_at) %></small>

        <div class="note-actions">
          <a class="button secondary" style="padding: 0.45rem 0.9rem; font-size: 0.85rem;" href="/notes/<%= note.id %>/edit">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path></svg>
            Editar
          </a>
          <form class="inline" action="/notes/<%= note.id %>/delete" method="post" onsubmit="return confirm('¿Seguro que deseas eliminar esta nota cifrada?');">
            <input type="hidden" name="csrfToken" value="<%= csrfToken %>">
            <button class="danger" style="padding: 0.45rem 0.9rem; font-size: 0.85rem;">
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg>
              Eliminar
            </button>
          </form>
        </div>
      </article>
    <% }) %>
  </div>

  <aside class="card note-form-aside animate-slide-up">
    <h2>Nueva Nota Segura</h2>
    <p style="font-size: 0.88rem;">El contenido se cifra en el servidor con tu clave maestra antes de ser escrito en PostgreSQL.</p>

    <form action="/notes" method="post">
      <input type="hidden" name="csrfToken" value="<%= csrfToken %>">

      <label for="title">Título del Secreto</label>
      <input id="title" name="title" maxlength="120" placeholder="Ej. Incidente subnivel 9" required>

      <label for="content">Contenido Privado</label>
      <textarea id="content" name="content" maxlength="5000" placeholder="Escribe el secreto aquí..." required></textarea>

      <button class="full-width" style="margin-top: 1.25rem;">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg>
        Guardar Cifrada
      </button>
    </form>
  </aside>
</section>

<%- include('partials/footer') %>
