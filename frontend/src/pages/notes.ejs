<%- include('partials/header') %>

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-4 flex flex-col gap-6">
  <!-- Title & Status Header -->
  <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-4 pb-4 border-b border-outline-variant/30">
    <div>
      <div class="flex items-center gap-1.5 font-mono text-xs text-secondary mb-1">
        <span class="material-symbols-outlined text-[14px]">shield</span>
        <span class="tracking-widest uppercase font-semibold">Zero-Trust Cryptographic Partition</span>
      </div>
      <h1 class="font-headline text-3xl font-bold text-on-surface tracking-tight">Bóveda de Notas Privadas</h1>
      <p class="text-sm text-on-surface-variant mt-1">Gestión de secretos y notas cifradas en reposo con AES-256-GCM.</p>
    </div>

    <div class="flex flex-wrap items-center gap-2.5 self-start lg:self-center">
      <!-- Status Pill -->
      <div class="flex items-center gap-2 px-3 py-1.5 rounded bg-secondary/10 border border-secondary/30 text-secondary font-mono text-xs">
        <span class="relative flex h-2 w-2">
          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-secondary opacity-75"></span>
          <span class="relative inline-flex rounded-full h-2 w-2 bg-secondary"></span>
        </span>
        <span class="font-semibold tracking-wide">Cifrado en Reposo Activo</span>
      </div>

      <!-- Badge Count -->
      <div class="flex items-center gap-1.5 px-3 py-1.5 rounded bg-surface-container-high border border-outline-variant/40 text-on-surface font-mono text-xs">
        <span class="material-symbols-outlined text-[15px] text-tertiary">inventory_2</span>
        <span class="font-semibold"><%= notes.length %> <%= notes.length === 1 ? 'Nota Almacenada' : 'Notas Almacenadas' %></span>
      </div>
    </div>
  </div>

  <!-- Main Split Layout (65% Feed / 35% Sticky Form) -->
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
    <!-- Left Column: Notes Feed (8 cols on lg) -->
    <div class="lg:col-span-8 flex flex-col gap-4">
      <% if (!notes.length) { %>
        <div class="flex flex-col items-center justify-center p-12 bg-surface-container-low border border-outline-variant/40 rounded-xl text-center">
          <div class="w-12 h-12 rounded-full bg-surface-container flex items-center justify-center text-outline mb-3">
            <span class="material-symbols-outlined text-2xl">folder_off</span>
          </div>
          <h3 class="font-headline text-lg font-semibold text-on-surface">No hay notas registradas</h3>
          <p class="text-xs text-on-surface-variant mt-1 max-w-sm">
            Tu partición criptográfica está vacía. Utiliza el panel lateral para guardar tu primer secreto protegido.
          </p>
        </div>
      <% } %>

      <% notes.forEach(note => { %>
        <article class="relative flex flex-col gap-3 p-5 bg-surface-container-low border border-outline-variant/40 rounded-xl border-l-4 border-l-secondary shadow-lg hover:border-outline-variant/70 transition-all">
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2">
            <div class="flex items-center gap-2.5 flex-wrap">
              <h2 class="font-headline text-lg text-on-surface font-semibold tracking-tight"><%= note.title %></h2>
              <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded bg-tertiary/10 border border-tertiary/30 text-tertiary font-mono text-[11px]">
                <span class="h-1.5 w-1.5 rounded-full bg-tertiary"></span>
                GCM Verified
              </span>
            </div>
            <span class="font-mono text-xs text-outline">
              Actualizada: <%= formatDateTime(note.updated_at) %>
            </span>
          </div>

          <!-- Decrypted Payload Container -->
          <div class="p-3.5 bg-surface-container-lowest rounded-lg border border-outline-variant/25 font-mono text-sm text-on-surface-variant leading-relaxed whitespace-pre-wrap break-words">
            <%= note.content %>
          </div>

          <!-- Actions Footer -->
          <div class="flex items-center justify-between pt-1">
            <div class="flex items-center gap-1 text-[11px] font-mono text-outline">
              <span class="material-symbols-outlined text-[13px] text-secondary">enhanced_encryption</span>
              <span>AES-256-GCM / 12-byte IV</span>
            </div>

            <div class="flex items-center gap-2">
              <a href="/notes/<%= note.id %>/edit" class="inline-flex items-center gap-1 px-2.5 py-1 rounded bg-surface-container hover:bg-surface-container-high text-on-surface text-xs font-medium transition-colors border border-outline-variant/30">
                <span class="material-symbols-outlined text-[14px]">edit</span>
                <span>Editar</span>
              </a>

              <form action="/notes/<%= note.id %>/delete" method="post" class="inline m-0" onsubmit="return confirm('¿Seguro que deseas eliminar permanentemente este registro cifrado?');">
                <input type="hidden" name="csrfToken" value="<%= csrfToken %>">
                <button type="submit" class="inline-flex items-center gap-1 px-2.5 py-1 rounded bg-error-container/20 hover:bg-error-container/40 text-error text-xs font-medium transition-colors border border-error/30">
                  <span class="material-symbols-outlined text-[14px]">delete</span>
                  <span>Eliminar</span>
                </button>
              </form>
            </div>
          </div>
        </article>
      <% }) %>
    </div>

    <!-- Right Column: Sticky Creation Aside (4 cols on lg) -->
    <div class="lg:col-span-4 sticky top-20 flex flex-col gap-4">
      <div class="p-6 bg-surface-container-low border border-outline-variant/40 rounded-xl shadow-xl flex flex-col gap-4">
        <div class="flex items-center gap-2 pb-3 border-b border-outline-variant/30">
          <div class="w-8 h-8 rounded-lg bg-surface-container flex items-center justify-center border border-secondary/30">
            <span class="material-symbols-outlined text-secondary text-base">add_box</span>
          </div>
          <div>
            <h3 class="font-headline text-base font-bold text-on-surface">Nueva Nota Segura</h3>
            <p class="text-[11px] text-outline font-mono">Cifrado antes de persistir</p>
          </div>
        </div>

        <form action="/notes" method="post" class="flex flex-col gap-3.5">
          <input type="hidden" name="csrfToken" value="<%= csrfToken %>">

          <div class="flex flex-col gap-1.5">
            <label class="text-xs font-medium text-on-surface-variant flex items-center justify-between" for="title">
              <span>Título del Secreto</span>
              <span class="font-mono text-[10px] text-outline">Máx 120</span>
            </label>
            <input class="w-full h-9 px-3 bg-surface-container-lowest text-on-surface text-sm rounded-lg border border-outline-variant/40 placeholder:text-outline focus:outline-none focus:border-secondary focus:ring-1 focus:ring-secondary/40 transition-all shadow-inner" id="title" name="title" maxlength="120" placeholder="Ej. Incidente subnivel 9" required/>
          </div>

          <div class="flex flex-col gap-1.5">
            <label class="text-xs font-medium text-on-surface-variant flex items-center justify-between" for="content">
              <span>Contenido Privado</span>
              <span class="font-mono text-[10px] text-outline">Máx 5000</span>
            </label>
            <textarea class="w-full h-32 p-3 bg-surface-container-lowest text-on-surface font-mono text-xs rounded-lg border border-outline-variant/40 placeholder:text-outline focus:outline-none focus:border-secondary focus:ring-1 focus:ring-secondary/40 transition-all resize-y shadow-inner leading-relaxed" id="content" name="content" maxlength="5000" placeholder="Escribe el secreto aquí..." required></textarea>
          </div>

          <button class="w-full h-10 bg-primary text-on-primary font-semibold text-xs rounded-lg flex items-center justify-center gap-2 hover:bg-primary-container transition-all shadow-md group mt-1" type="submit">
            <span class="material-symbols-outlined text-base">lock</span>
            <span>Guardar Cifrada en Base</span>
          </button>
        </form>
      </div>
    </div>
  </div>
</div>

<%- include('partials/footer') %>
