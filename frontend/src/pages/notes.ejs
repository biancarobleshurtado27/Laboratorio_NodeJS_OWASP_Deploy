<%- include('partials/header') %><section class="split"><div><h1>Mis notas</h1><p>El contenido se cifra con AES-256-GCM antes de guardarse.</p><% if (!notes.length) { %><p class="empty">Todavía no hay notas.</p><% } %><% notes.forEach(note => { %><article class="note"><h2><%= note.title %></h2><p><%= note.content %></p><small>Actualizada: <%= new Date(note.updated_at).toLocaleString('es-CR') %></small><div><a class="button secondary" href="/notes/<%= note.id %>/edit">Editar</a><form class="inline" action="/notes/<%= note.id %>/delete" method="post"><input type="hidden" name="csrfToken" value="<%= csrfToken %>"><button class="danger">Eliminar</button></form></div></article><% }) %></div><aside class="card"><h2>Nueva nota</h2><form action="/notes" method="post"><input type="hidden" name="csrfToken" value="<%= csrfToken %>"><label>Título<input name="title" maxlength="120" required></label><label>Contenido<textarea name="content" maxlength="5000" required></textarea></label><button>Guardar cifrada</button></form></aside></section><%- include('partials/footer') %>
