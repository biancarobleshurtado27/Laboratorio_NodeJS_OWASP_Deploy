<%- include('partials/header') %>

<div class="max-w-2xl mx-auto px-4 py-8">
  <div class="p-6 sm:p-8 bg-surface-container-low border border-outline-variant/40 rounded-xl shadow-2xl flex flex-col gap-6">
    <div class="flex items-center gap-3 pb-4 border-b border-outline-variant/30">
      <div class="w-10 h-10 rounded-lg bg-surface-container flex items-center justify-center border border-secondary/30">
        <span class="material-symbols-outlined text-secondary text-xl">edit_note</span>
      </div>
      <div>
        <h1 class="font-headline text-xl font-bold text-on-surface">Editar Nota Cifrada</h1>
        <p class="text-xs text-outline font-mono">El registro se descifró temporalmente para ti y se re-cifrará con un nuevo IV.</p>
      </div>
    </div>

    <form action="/notes/<%= note.id %>/edit" method="post" class="flex flex-col gap-4">
      <input type="hidden" name="csrfToken" value="<%= csrfToken %>">

      <div class="flex flex-col gap-1.5">
        <label class="text-xs font-medium text-on-surface-variant flex items-center justify-between" for="title">
          <span>Título del Secreto</span>
          <span class="font-mono text-[10px] text-outline">Máx 120</span>
        </label>
        <input class="w-full h-10 px-3 bg-surface-container-lowest text-on-surface text-sm rounded-lg border border-outline-variant/40 focus:outline-none focus:border-secondary focus:ring-1 focus:ring-secondary/40 transition-all shadow-inner" id="title" name="title" value="<%= note.title %>" maxlength="120" required/>
      </div>

      <div class="flex flex-col gap-1.5">
        <label class="text-xs font-medium text-on-surface-variant flex items-center justify-between" for="content">
          <span>Contenido Privado</span>
          <span class="font-mono text-[10px] text-outline">Máx 5000</span>
        </label>
        <textarea class="w-full h-44 p-3 bg-surface-container-lowest text-on-surface font-mono text-xs rounded-lg border border-outline-variant/40 focus:outline-none focus:border-secondary focus:ring-1 focus:ring-secondary/40 transition-all resize-y shadow-inner leading-relaxed" id="content" name="content" maxlength="5000" required><%= note.content %></textarea>
      </div>

      <div class="flex items-center gap-3 pt-2">
        <button class="flex-1 h-11 bg-primary text-on-primary font-semibold text-sm rounded-lg flex items-center justify-center gap-2 hover:bg-primary-container transition-all shadow-md" type="submit">
          <span class="material-symbols-outlined text-base">lock_reset</span>
          <span>Actualizar y Re-cifrar</span>
        </button>
        <a href="/notes" class="px-4 py-2.5 rounded-lg bg-surface-container hover:bg-surface-container-high text-on-surface text-sm font-medium transition-colors border border-outline-variant/30">
          Cancelar
        </a>
      </div>
    </form>
  </div>
</div>

<%- include('partials/footer') %>
