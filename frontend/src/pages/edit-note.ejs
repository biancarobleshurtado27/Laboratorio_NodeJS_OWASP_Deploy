<%- include('partials/header') %>

<section class="card narrow animate-slide-up" style="max-width: 600px;">
  <div class="security-pill">
    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path></svg>
    Edición Segura de Secreto
  </div>

  <h1>Editar Nota Cifrada</h1>
  <p class="lead">El contenido se descifró temporalmente para ti y se volverá a cifrar con un nuevo IV al guardar.</p>

  <form action="/notes/<%= note.id %>/edit" method="post">
    <input type="hidden" name="csrfToken" value="<%= csrfToken %>">

    <label for="title">Título</label>
    <input id="title" name="title" value="<%= note.title %>" maxlength="120" required>

    <label for="content">Contenido Privado</label>
    <textarea id="content" name="content" maxlength="5000" required><%= note.content %></textarea>

    <div style="display:flex; gap: 1rem; margin-top: 1.5rem;">
      <button type="submit" class="full-width">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"></path><polyline points="17 21 17 13 7 13 7 21"></polyline><polyline points="7 3 7 8 15 8"></polyline></svg>
        Actualizar y Re-cifrar
      </button>
      <a href="/notes" class="button secondary" style="width: auto;">Cancelar</a>
    </div>
  </form>
</section>

<%- include('partials/footer') %>
