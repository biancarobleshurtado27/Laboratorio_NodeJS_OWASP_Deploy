<%- include('partials/header') %>

<div style="margin-bottom: 2rem;">
  <div class="security-pill" style="background: rgba(245, 158, 11, 0.15); color: #fbbf24; border-color: rgba(245, 158, 11, 0.3);">
    <svg fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M2.166 4.999A11.954 11.954 0 0010 1.944 11.954 11.954 0 0017.834 5c.11.65.166 1.32.166 2.001 0 5.225-3.34 9.67-8 11.317C5.34 16.67 2 12.225 2 7c0-.682.057-1.35.166-2.001zm11.541 3.708a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path></svg>
    Consola de Control y Auditoría (Admin Only)
  </div>
  <h1>Panel de Administración</h1>
  <p>Supervisión de identidades y registro de eventos de seguridad (OWASP A09 / RF-07).</p>
</div>

<section class="card">
  <h2>Usuarios Registrados</h2>
  <div class="table-wrapper">
    <table>
      <thead>
        <tr>
          <th>ID</th>
          <th>Nombre</th>
          <th>Correo Corporativo</th>
          <th>Rol Actual</th>
          <th>Gestión de Rol</th>
        </tr>
      </thead>
      <tbody>
        <% users.forEach(member => { %>
          <tr>
            <td style="font-family: var(--font-mono); color: var(--text-muted);"><%= member.id %></td>
            <td style="font-weight: 600;"><%= member.name %></td>
            <td><%= member.email %></td>
            <td>
              <span class="brand-badge" style="background: <%= member.role === 'admin' ? 'rgba(245, 158, 11, 0.2)' : 'rgba(59, 130, 246, 0.2)' %>; color: <%= member.role === 'admin' ? '#fbbf24' : '#60a5fa' %>;">
                <%= member.role %>
              </span>
            </td>
            <td>
              <% if (member.id !== user.id) { %>
                <form action="/admin/users/<%= member.id %>/role" method="post" style="display:flex; gap:0.5rem; align-items:center;">
                  <input type="hidden" name="csrfToken" value="<%= csrfToken %>">
                  <select name="role" style="padding: 0.35rem 0.6rem; font-size: 0.85rem; width: auto;">
                    <option value="user" <%= member.role === 'user' ? 'selected' : '' %>>usuario</option>
                    <option value="admin" <%= member.role === 'admin' ? 'selected' : '' %>>administrador</option>
                  </select>
                  <button class="secondary" style="padding: 0.35rem 0.75rem; font-size: 0.85rem;">Actualizar</button>
                </form>
              <% } else { %>
                <span class="hint">(Tu usuario actual)</span>
              <% } %>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</section>

<section class="card">
  <h2>Bitácora de Auditoría en Tiempo Real (`audit_logs`)</h2>
  <p class="hint">Zona horaria: America/Costa_Rica — Registros sin credenciales ni tokens sensibles.</p>

  <div class="table-wrapper">
    <table>
      <thead>
        <tr>
          <th>Fecha y Hora</th>
          <th>Evento de Seguridad</th>
          <th>Actor (Usuario)</th>
          <th>Dirección IP</th>
        </tr>
      </thead>
      <tbody>
        <% logs.forEach(entry => { %>
          <tr>
            <td style="font-family: var(--font-mono); font-size: 0.82rem; color: var(--text-secondary);"><%= formatDateTime(entry.created_at) %></td>
            <td>
              <span class="event-tag event-<%= entry.event %>">
                <%= entry.event %>
              </span>
            </td>
            <td><%= entry.actor || 'sistema / anónimo' %></td>
            <td style="font-family: var(--font-mono); font-size: 0.85rem; color: #94a3b8;"><%= entry.ip || '-' %></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</section>

<%- include('partials/footer') %>
