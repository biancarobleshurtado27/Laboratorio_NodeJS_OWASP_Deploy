<%- include('partials/header') %>

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-4 flex flex-col gap-6">
  <!-- Title & Status Header -->
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-4 border-b border-outline-variant/30">
    <div>
      <div class="flex items-center gap-1.5 font-mono text-xs text-amber-400 mb-1">
        <span class="material-symbols-outlined text-[14px]">admin_panel_settings</span>
        <span class="tracking-widest uppercase font-semibold">Consola de Control y Auditoría (Admin Only)</span>
      </div>
      <h1 class="font-headline text-3xl font-bold text-on-surface tracking-tight">Panel de Administración</h1>
      <p class="text-sm text-on-surface-variant mt-1">Supervisión de usuarios y bitácora de eventos de seguridad (OWASP A09 / RF-07).</p>
    </div>

    <div class="flex items-center gap-2 self-start sm:self-center font-mono text-xs text-outline px-3 py-1.5 rounded bg-surface-container-high border border-outline-variant/30">
      <span class="material-symbols-outlined text-sm text-secondary">schedule</span>
      <span>Zona: America/Costa_Rica</span>
    </div>
  </div>

  <!-- Users Table Section -->
  <div class="p-6 bg-surface-container-low border border-outline-variant/40 rounded-xl shadow-xl flex flex-col gap-4">
    <div class="flex items-center gap-2">
      <span class="material-symbols-outlined text-primary text-xl">group</span>
      <h2 class="font-headline text-lg font-bold text-on-surface">Usuarios Registrados en el Sistema</h2>
    </div>

    <div class="overflow-x-auto border border-outline-variant/30 rounded-lg">
      <table class="w-full text-left font-mono text-xs">
        <thead class="bg-surface-container text-outline border-b border-outline-variant/30 uppercase tracking-wider text-[11px]">
          <tr>
            <th class="py-3 px-4">ID</th>
            <th class="py-3 px-4">Nombre</th>
            <th class="py-3 px-4">Correo</th>
            <th class="py-3 px-4">Rol</th>
            <th class="py-3 px-4">Acción</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-outline-variant/20">
          <% users.forEach(member => { %>
            <tr class="hover:bg-surface-container-lowest/50 transition-colors">
              <td class="py-3 px-4 text-outline"><%= member.id %></td>
              <td class="py-3 px-4 text-on-surface font-semibold font-sans"><%= member.name %></td>
              <td class="py-3 px-4 text-on-surface-variant"><%= member.email %></td>
              <td class="py-3 px-4">
                <span class="px-2 py-0.5 rounded text-[11px] font-semibold <%= member.role === 'admin' ? 'bg-amber-950/40 text-amber-300 border border-amber-600/30' : 'bg-primary/10 text-primary border border-primary/30' %>">
                  <%= member.role %>
                </span>
              </td>
              <td class="py-3 px-4">
                <% if (member.id !== user.id) { %>
                  <form action="/admin/users/<%= member.id %>/role" method="post" class="flex items-center gap-2 m-0">
                    <input type="hidden" name="csrfToken" value="<%= csrfToken %>">
                    <select name="role" class="bg-surface-container-lowest text-on-surface text-xs rounded border border-outline-variant/40 px-2 py-1 focus:outline-none focus:border-secondary">
                      <option value="user" <%= member.role === 'user' ? 'selected' : '' %>>usuario</option>
                      <option value="admin" <%= member.role === 'admin' ? 'selected' : '' %>>administrador</option>
                    </select>
                    <button type="submit" class="px-2.5 py-1 rounded bg-secondary/15 hover:bg-secondary/25 text-secondary text-xs font-semibold border border-secondary/30 transition-colors">
                      Guardar
                    </button>
                  </form>
                <% } else { %>
                  <span class="text-outline text-[11px] italic">(Tu sesión)</span>
                <% } %>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>

  <!-- Audit Logs Section -->
  <div class="p-6 bg-surface-container-low border border-outline-variant/40 rounded-xl shadow-xl flex flex-col gap-4">
    <div class="flex items-center justify-between">
      <div class="flex items-center gap-2">
        <span class="material-symbols-outlined text-secondary text-xl">security</span>
        <h2 class="font-headline text-lg font-bold text-on-surface">Bitácora de Auditoría de Seguridad (`audit_logs`)</h2>
      </div>
      <span class="text-xs font-mono text-outline">Sin contraseñas ni tokens expuestos</span>
    </div>

    <div class="overflow-x-auto border border-outline-variant/30 rounded-lg">
      <table class="w-full text-left font-mono text-xs">
        <thead class="bg-surface-container text-outline border-b border-outline-variant/30 uppercase tracking-wider text-[11px]">
          <tr>
            <th class="py-3 px-4">Fecha y Hora</th>
            <th class="py-3 px-4">Evento</th>
            <th class="py-3 px-4">Actor</th>
            <th class="py-3 px-4">Dirección IP</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-outline-variant/20">
          <% logs.forEach(entry => { %>
            <tr class="hover:bg-surface-container-lowest/50 transition-colors">
              <td class="py-3 px-4 text-outline"><%= formatDateTime(entry.created_at) %></td>
              <td class="py-3 px-4">
                <% if (entry.event === 'login_success') { %>
                  <span class="px-2 py-0.5 rounded bg-tertiary/10 text-tertiary border border-tertiary/30 text-[11px] font-semibold">login_success</span>
                <% } else if (entry.event === 'login_failed' || entry.event === 'login_failure_alert') { %>
                  <span class="px-2 py-0.5 rounded bg-error-container/30 text-error border border-error/40 text-[11px] font-semibold"><%= entry.event %></span>
                <% } else if (entry.event === 'access_denied') { %>
                  <span class="px-2 py-0.5 rounded bg-amber-950/40 text-amber-300 border border-amber-600/30 text-[11px] font-semibold">access_denied</span>
                <% } else { %>
                  <span class="px-2 py-0.5 rounded bg-surface-container text-on-surface-variant border border-outline-variant/30 text-[11px] font-semibold"><%= entry.event %></span>
                <% } %>
              </td>
              <td class="py-3 px-4 text-on-surface"><%= entry.actor || 'sistema' %></td>
              <td class="py-3 px-4 text-secondary"><%= entry.ip || '-' %></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<%- include('partials/footer') %>
