<%- include('partials/header') %>

<div class="flex flex-col w-full items-center justify-center relative overflow-hidden py-8 px-4">
  <!-- Glow Background -->
  <div class="absolute inset-0 pointer-events-none flex items-center justify-center opacity-30">
    <div class="w-[500px] h-[500px] rounded-full bg-gradient-to-tr from-primary-container/20 to-secondary/10 blur-3xl transform scale-110"></div>
  </div>

  <!-- Primary Security Envelope Card -->
  <div class="relative w-full max-w-[440px] bg-surface-container-low border border-outline-variant/40 rounded-xl shadow-2xl p-6 sm:p-8 z-10 flex flex-col gap-6 backdrop-blur-md">
    <!-- Card Header -->
    <div class="flex flex-col items-center text-center gap-2">
      <!-- Shield Badge -->
      <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-surface-container-highest text-secondary font-mono text-xs tracking-wide border border-outline-variant/30">
        <span class="material-symbols-outlined text-secondary text-[14px]">verified_user</span>
        <span>Autenticación Segura (Bcrypt Cost 12)</span>
      </div>

      <!-- Icon Badge -->
      <div class="mt-2 w-12 h-12 rounded-lg bg-surface-container flex items-center justify-center border border-secondary/20 shadow-inner">
        <span class="material-symbols-outlined text-primary text-2xl">lock</span>
      </div>

      <div class="flex flex-col gap-1 mt-1">
        <h1 class="font-headline text-2xl text-on-surface font-bold tracking-tight">Iniciar Sesión</h1>
        <p class="text-sm text-on-surface-variant max-w-[340px] leading-relaxed">
          Ingresa tus credenciales para descifrar tu sesión local en SecureVault.
        </p>
      </div>
    </div>

    <!-- Login Form -->
    <form action="/login" method="post" class="flex flex-col gap-4">
      <input type="hidden" name="csrfToken" value="<%= csrfToken %>">

      <!-- Field: Correo -->
      <div class="flex flex-col gap-1.5">
        <label class="text-xs font-medium text-on-surface-variant flex items-center justify-between" for="email">
          <span>Correo Corporativo</span>
          <span class="font-mono text-[11px] text-outline">FIPS-Compliant</span>
        </label>
        <div class="relative flex items-center">
          <span class="material-symbols-outlined absolute left-3 text-outline text-lg pointer-events-none">mail</span>
          <input class="w-full h-10 pl-10 pr-3 bg-surface-container-lowest text-on-surface text-sm rounded-lg border border-outline-variant/40 placeholder:text-outline focus:outline-none focus:border-secondary focus:ring-1 focus:ring-secondary/40 transition-all shadow-inner" id="email" name="email" placeholder="luna@umbrafiction.example" required type="email" autocomplete="email"/>
        </div>
      </div>

      <!-- Field: Contraseña -->
      <div class="flex flex-col gap-1.5">
        <div class="flex items-center justify-between">
          <label class="text-xs font-medium text-on-surface-variant" for="password">Contraseña Maestra</label>
          <a href="/forgot-password" class="text-xs text-primary hover:text-primary-container transition-colors">
            ¿Olvidaste tu contraseña?
          </a>
        </div>
        <div class="relative flex items-center">
          <span class="material-symbols-outlined absolute left-3 text-outline text-lg pointer-events-none">key</span>
          <input class="w-full h-10 pl-10 pr-10 bg-surface-container-lowest text-on-surface font-mono text-sm rounded-lg border border-outline-variant/40 placeholder:text-outline focus:outline-none focus:border-secondary focus:ring-1 focus:ring-secondary/40 transition-all shadow-inner" id="password" name="password" placeholder="••••••••••••••••" required type="password" autocomplete="current-password"/>
          <button type="button" onclick="const p=document.getElementById('password'); p.type = p.type==='password'?'text':'password';" class="absolute right-2.5 p-1 text-outline hover:text-on-surface transition-colors" title="Mostrar/Ocultar">
            <span class="material-symbols-outlined text-lg leading-none">visibility</span>
          </button>
        </div>
      </div>

      <!-- Submit Action -->
      <button class="w-full h-11 bg-primary text-on-primary font-semibold text-sm rounded-lg flex items-center justify-center gap-2 hover:bg-primary-container transition-all shadow-md mt-2 group" type="submit">
        <span>Ingresar a la Bóveda</span>
        <span class="material-symbols-outlined text-lg group-hover:translate-x-0.5 transition-transform">arrow_forward</span>
      </button>

      <% if (isDevelopment) { %>
        <button type="button" onclick="document.getElementById('demo-form').submit();" class="w-full h-10 bg-surface-container text-on-surface-variant text-xs font-medium rounded-lg border border-outline-variant/30 hover:bg-surface-container-high hover:text-on-surface transition-colors">
          ⚡ Acceso Rápido de Demostración (Local)
        </button>
      <% } %>
    </form>

    <% if (isDevelopment) { %>
      <form id="demo-form" action="/demo-login" method="post" style="display:none;">
        <input type="hidden" name="csrfToken" value="<%= csrfToken %>">
      </form>
    <% } %>

    <!-- Footer of card -->
    <div class="pt-4 border-t border-outline-variant/30 text-center text-xs text-on-surface-variant">
      <span>¿No posees credenciales en esta bóveda?</span>
      <a href="/register" class="text-secondary font-semibold hover:underline ml-1">Regístrate aquí</a>
    </div>
  </div>
</div>

<%- include('partials/footer') %>
