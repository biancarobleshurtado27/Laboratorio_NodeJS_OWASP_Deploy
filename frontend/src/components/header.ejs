<!doctype html><html lang="es"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><%= title %> | <%= viewContext.applicationName %></title><link rel="stylesheet" href="/styles/styles.css"></head><body><header><a class="brand" href="/"><%= viewContext.applicationName %></a><nav><% if (user) { %><a href="/notes">Notas</a><a href="/profile">Perfil</a><% if (user.role === 'admin') { %><a href="/admin">Admin</a><% } %><form action="/logout" method="post"><input type="hidden" name="csrfToken" value="<%= csrfToken %>"><button class="link">Salir</button></form><% } %></nav></header><main><% if (flash) { %><p class="flash <%= flash.type %>"><%= flash.message %></p><% } %>
