<%- include('partials/header') %><section class="card narrow"><h1>Editar nota</h1><form action="/notes/<%= note.id %>" method="post"><input type="hidden" name="csrfToken" value="<%= csrfToken %>"><label>Título<input name="title" maxlength="120" value="<%= note.title %>" required></label><label>Contenido<textarea name="content" maxlength="5000" required><%= note.content %></textarea></label><button>Guardar cambios</button><a class="button secondary" href="/notes">Cancelar</a></form></section><%- include('partials/footer') %>
