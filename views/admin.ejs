<%- include('partials/header') %><h1>Administración</h1><section class="card"><h2>Usuarios</h2><table><thead><tr><th>ID</th><th>Nombre</th><th>Correo</th><th>Rol</th><th>Acción</th></tr></thead><tbody><% users.forEach(member => { %><tr><td><%= member.id %></td><td><%= member.name %></td><td><%= member.email %></td><td><%= member.role %></td><td><% if (member.id !== user.id) { %><form action="/admin/users/<%= member.id %>/role" method="post"><input type="hidden" name="csrfToken" value="<%= csrfToken %>"><select name="role"><option value="user" <%= member.role === 'user' ? 'selected' : '' %>>usuario</option><option value="admin" <%= member.role === 'admin' ? 'selected' : '' %>>administrador</option></select><button>Guardar</button></form><% } %></td></tr><% }) %></tbody></table></section><section class="card"><h2>Bitácora de seguridad</h2><table><thead><tr><th>Fecha</th><th>Evento</th><th>Actor</th><th>IP</th></tr></thead><tbody><% logs.forEach(entry => { %><tr><td><%= new Date(entry.created_at).toLocaleString('es-CR') %></td><td><%= entry.event %></td><td><%= entry.actor || 'sistema' %></td><td><%= entry.ip || '-' %></td></tr><% }) %></tbody></table></section><%- include('partials/footer') %>
